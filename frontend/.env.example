# FastAPI address used by the local Vite proxy
SETU_BACKEND_TARGET=http://127.0.0.1:8081

# Supabase Auth — use your project's public URL and publishable/anon key only.
# Never put a service_role key or database password in frontend environment variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional if the API is hosted separately. Leave blank to use the Vite proxy.
VITE_SETU_API_URL=
